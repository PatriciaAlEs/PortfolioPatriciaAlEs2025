# Variables de entorno para el backend Flask
# Copia este archivo como .env y completa los valores

# URL de la base de datos (Render la generará automáticamente)
DATABASE_URL=postgresql://user:password@host:5432/database

# Clave secreta para JWT (Render la generará automáticamente)
JWT_SECRET=tu-clave-secreta-super-segura-aqui

# Entorno (development, production, testing)
FLASK_ENV=production

# Frontend base path
BASENAME=/